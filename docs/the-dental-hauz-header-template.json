{"content": [{"id": "dh0a1b2", "elType": "section", "settings": {"layout": "full_width", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "background_background": "classic", "background_color": "#F4F0E8"}, "elements": [{"id": "dh3c4d5", "elType": "column", "settings": {"_column_size": 100, "_inline_size": null, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "dh6e7f8", "elType": "widget", "settings": {"html": "<!--\n  The Dental Hauz - header bar for the OLD (Elementor) site.\n  Paste into an Elementor \"HTML\" widget at the top of the Header template, or into any page.\n  Self-contained: no plugin, no JavaScript. Brand colours only:\n  #514A43 #657568 #A8B6A5 #D8B8B2 #F4F0E8\n-->\n<style>\n.dhx { --u:#514A43; --sd:#657568; --s:#A8B6A5; --b:#D8B8B2; --c:#F4F0E8; position:relative; z-index:50; background:#F4F0E8; border-bottom:1px solid rgba(81,74,67,.16); font-family:\"Jost\",\"Garet\",system-ui,sans-serif; }\n.dhx *, .dhx *::before, .dhx *::after { box-sizing:border-box; }\n.dhx a { text-decoration:none; color:#514A43; }\n.dhx ul { list-style:none; margin:0; padding:0; }\n.dhx__bar { max-width:1320px; margin:0 auto; padding:10px 24px; display:flex; align-items:center; justify-content:space-between; gap:24px; }\n.dhx__logo img { display:block; height:52px; width:auto; }\n.dhx__toggle { display:none; }\n.dhx__burger { display:none; cursor:pointer; width:44px; height:44px; border:1px solid rgba(81,74,67,.3); border-radius:12px; align-items:center; justify-content:center; flex-direction:column; gap:5px; }\n.dhx__burger span { display:block; width:20px; height:2px; background:#514A43; }\n.dhx__nav { display:flex; align-items:center; gap:26px; }\n.dhx__menu { display:flex; align-items:center; gap:26px; }\n.dhx__menu > li { position:relative; }\n.dhx__menu > li > a { display:inline-block; padding:10px 0; font-size:12px; letter-spacing:.15em; text-transform:uppercase; white-space:nowrap; color:#514A43; }\n.dhx__menu > li > a:hover, .dhx__menu > li:focus-within > a { color:#657568; }\n.dhx__sub { position:absolute; left:-14px; top:100%; min-width:280px; padding:10px; background:#F4F0E8; border:1px solid rgba(81,74,67,.16); border-radius:16px; box-shadow:0 24px 50px -28px rgba(81,74,67,.5); display:none; }\n.dhx__menu > li:hover > .dhx__sub, .dhx__menu > li:focus-within > .dhx__sub { display:block; }\n.dhx__sub a { display:block; padding:9px 12px; border-radius:10px; font-size:13px; letter-spacing:.04em; text-transform:none; color:#514A43; }\n.dhx__sub a:hover { background:#A8B6A5; }\n.dhx__social { display:flex; align-items:center; gap:16px; padding-left:24px; border-left:1px solid rgba(81,74,67,.2); }\n.dhx__social a { display:flex; width:22px; height:22px; color:#514A43; }\n.dhx__social a:hover { color:#657568; }\n.dhx__social svg { width:100%; height:100%; fill:currentColor; }\n.dhx a.dhx__btn { display:inline-block; padding:14px 26px; border-radius:999px; background:#514A43; color:#F4F0E8; font-size:12px; letter-spacing:.2em; text-transform:uppercase; white-space:nowrap; transition:background .2s; }\n.dhx a.dhx__btn:hover { background:#657568; color:#F4F0E8; }\n@media (max-width:1180px) {\n  .dhx__bar { flex-wrap:wrap; }\n  .dhx__logo img { height:46px; }\n  .dhx__burger { display:flex; }\n  .dhx__nav { display:none; width:100%; flex-direction:column; align-items:stretch; gap:14px; padding:8px 0 18px; }\n  .dhx__toggle:checked ~ .dhx__nav { display:flex; }\n  .dhx__menu { flex-direction:column; align-items:stretch; gap:0; }\n  .dhx__menu > li > a { display:block; padding:13px 0; border-bottom:1px solid rgba(81,74,67,.12); }\n  .dhx__sub { position:static; display:block; min-width:0; padding:4px 0 4px 14px; border:0; box-shadow:none; background:transparent; }\n  .dhx__social { padding-left:0; border-left:0; }\n  .dhx a.dhx__btn { text-align:center; }\n}\n</style>\n\n<header class=\"dhx\">\n  <div class=\"dhx__bar\">\n    <a class=\"dhx__logo\" href=\"/\" aria-label=\"The Dental Hauz\">\n      <img src=\"https://ahmedmohamedkhalilx-droid.github.io/The-dental-Website-/assets/img/logo-dark.png\" alt=\"The Dental Hauz\" width=\"879\" height=\"258\">\n    </a>\n    <input class=\"dhx__toggle\" type=\"checkbox\" id=\"dhx-toggle\" aria-label=\"Open menu\">\n    <label class=\"dhx__burger\" for=\"dhx-toggle\" aria-hidden=\"true\"><span></span><span></span><span></span></label>\n    <nav class=\"dhx__nav\" aria-label=\"Main\">\n      <ul class=\"dhx__menu\">\n        <li><a href=\"/\">Home</a></li>\n        <li><a href=\"/about-us/\">About Us</a></li>\n        <li><a href=\"/doctors/\">Doctors</a></li>\n        <li>\n          <a href=\"/our-services/\">Services &#9662;</a>\n          <ul class=\"dhx__sub\">\n            <li><a href=\"/comprehensive-oral-examination/\">Comprehensive Oral Examination</a></li>\n            <li><a href=\"/dental-cleaning/\">Dental Cleaning</a></li>\n            <li><a href=\"/tooth-colored-restorations/\">Tooth-Colored Restorations</a></li>\n            <li><a href=\"/crowns-bridges/\">Crowns &amp; Bridges</a></li>\n            <li><a href=\"/dental-implants/\">Dental Implants</a></li>\n            <li><a href=\"/orthodontics-clear-aligners/\">Orthodontics &amp; Clear Aligners</a></li>\n            <li><a href=\"/simple-wisdom-tooth-extractions/\">Simple &amp; Wisdom Tooth Extractions</a></li>\n            <li><a href=\"/root-canal-therapy/\">Root Canal Therapy</a></li>\n            <li><a href=\"/kids-dentistry/\">Kids Dentistry</a></li>\n            <li><a href=\"/teeth-whitening/\">Teeth Whitening</a></li>\n          </ul>\n        </li>\n        <li><a href=\"/testimonial/\">Testimonial</a></li>\n        <li><a href=\"/faqs/\">FAQ&rsquo;s</a></li>\n        <li><a href=\"/forms/\">Forms</a></li>\n        <li><a href=\"/contact-us/\">Contact Us</a></li>\n      </ul>\n      <div class=\"dhx__social\">\n        <a href=\"https://www.facebook.com/profile.php?id=61588796471226\" aria-label=\"Facebook\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.4H7.7V13h2.7v8h3.1z\"/></svg></a>\n        <a href=\"https://www.instagram.com/thedental.hauz\" aria-label=\"Instagram\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.3-3.6a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z\"/></svg></a>\n      </div>\n      <a class=\"dhx__btn\" href=\"/forms/\">Book Appointment</a>\n    </nav>\n  </div>\n</header>\n"}, "elements": [], "widgetType": "html"}], "isInner": false}], "isInner": false}], "page_settings": [], "version": "0.4", "title": "The Dental Hauz Header", "type": "header"}